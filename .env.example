# Endereço da API. Em desenvolvimento deixe "/api" (o Vite repassa ao
# backend). Em produção, aponte para a URL pública do backend, por exemplo
# https://minha-api.onrender.com/api
VITE_API_URL=/api

# Avatar realista opcional: caminho de um .glb (ex.: /models/avatar.glb,
# com o arquivo em public/models/). Vazio = personagem modelado em código.
VITE_AVATAR_MODEL_URL=
